{
  "name": "oficina-lambda-auth-dev",
  "private": true,
  "description": "Ferramentas de desenvolvimento e testes da Lambda de autenticação (o código implantado fica em src/)",
  "scripts": {
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "modulePaths": [
      "<rootDir>/src/node_modules"
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
